# URL de conexión PostgreSQL de Supabase (incluye sslmode=require).
DATABASE_URL=

# Access token privado de Mercado Pago; nunca uses una clave pública aquí.
MERCADO_PAGO_ACCESS_TOKEN=

# Clave aleatoria estable para firmar sesiones JWT.
JWT_SECRET=

# Opcional en local. En Render se usa RENDER_EXTERNAL_URL automáticamente.
# FRONTEND_URL=http://localhost:5173
